LOCAL_HOST=0.0.0.0
LOCAL_PORT=5050

# Telegram bot pool — repeat with _2, _3, ... for more bots.
TELEGRAM_BOT_TOKEN_1=your_bot_token_here
TELEGRAM_CHANNEL_ID_1=-1001234567890

# File handling.
# Raise this if Telegram increases Bot API file size limits.
TELEGRAM_MAX_FILE_SIZE=20971520
# User-configurable; adjust if upload ceiling changes.
# SEGMENT_TARGET_SIZE=15728640
MAX_UPLOAD_SIZE=107374182400
UPLOAD_CHUNK_SIZE=10485760

# Reliability.
MAX_CONCURRENT_JOBS=1
DB_SYNC_ENABLED=true
# Auto-written after the first successful DB sync snapshot.
DB_SYNC_BOOTSTRAP=

# Adaptive bitrate (mutually exclusive: virtual ABR is silently disabled if both true).
ABR_ENABLED=true
ENABLE_COPY_MODE=true
VIRTUAL_ABR_TIERS=false

# GitHub — used by SEASON END auto-PR.
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=your_repo_name
GITHUB_BASE_BRANCH=main

RUST_LOG=info
CLOUDFLARED_CONFIG=
